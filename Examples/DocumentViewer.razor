@page "/document-viewer"
@using PdfViewer

<PageTitle>PDF document viewer</PageTitle>

<div class="example-shell">
    <header class="example-header">
        <div>
            <p class="example-eyebrow">DOCUMENTS</p>
            <h1>PDF viewer</h1>
            <p class="example-description">
                A responsive PDF experience that adapts from a compact phone viewport to a large desktop workspace.
            </p>
        </div>
        <div class="example-badge">Blazor component</div>
    </header>

    <main>
        <PdfViewer Url="SamplePdfUrl"
                   FileName="sample-document.pdf"
                   Height="min(76vh, 920px)"
                   aria-label="Sample PDF document viewer" />
    </main>

    <p class="example-note">
        This example uses the public PDF.js sample document. Replace <code>SamplePdfUrl</code> with your own same-origin or CORS-enabled PDF endpoint.
    </p>
</div>

@code {
    private const string SamplePdfUrl = "https://mozilla.github.io/pdf.js/web/compressed.tracemonkey-pldi-09.pdf";
}
